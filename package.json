{
  "name": "reveal",
  "version": "0.46.2",
  "private": true,
  "description": "Reveal — personal photography app (Tauri 2 + Rust + wgpu + Svelte 5)",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "if [ -n \"$TURBO_HASH\" ]; then vite dev; else tauri dev; fi",
    "build": "./install.sh",
    "dev:web": "vite dev",
    "build:web": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "tauri": "tauri",
    "generate:garden-themes": "node scripts/generate-garden-themes.mjs",
    "audit:css-tokens": "sass --load-path=node_modules --no-source-map .audit-entry.scss /tmp/reveal-framework.css && node scripts/audit-css-tokens.mjs /tmp/reveal-framework.css",
    "test": "vitest run"
  },
  "dependencies": {
    "@stnd/fonts": "^0.5.2",
    "@stnd/styles": "^0.13.4",
    "@stnd/ui": "^0.8.8",
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.12.1",
    "js-yaml": "^4.1.0",
    "sass": "^1.83.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.7.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
