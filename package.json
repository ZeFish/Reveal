{
  "name": "reveal",
  "version": "2.0.8",
  "private": true,
  "description": "Reveal — personal photography app (Tauri 2 + Rust + wgpu + Svelte 5)",
  "type": "module",
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json",
    "tauri": "tauri",
    "generate:garden-themes": "node scripts/generate-garden-themes.mjs",
    "audit:css-tokens": "sass --load-path=node_modules --no-source-map .audit-entry.scss /tmp/reveal-framework.css && node scripts/audit-css-tokens.mjs /tmp/reveal-framework.css"
  },
  "dependencies": {
    "@stnd/fonts": "^0.5.1",
    "@stnd/styles": "^0.7.4",
    "@stnd/ui": "^0.6.1",
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.69.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2.11.4",
    "js-yaml": "^4.1.0",
    "sass": "^1.83.0",
    "svelte": "5.57.0",
    "svelte-check": "^4.7.1",
    "vite": "^8.1.0"
  }
}
